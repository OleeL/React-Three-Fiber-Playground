		"@react-three/fiber": "^9.6.1",
		"next": "16.2.11",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"styled-jsx": "^5.1.6",
		"three": "^0.166.1",
		"zustand": "^4.5.4"
	},
	"devDependencies": {
		"@eslint/compat": "^1.1.0",
		"@eslint/js": "^9.6.0",
		"@types/node": "^25.9.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/three": "^0.184.1",
		"@typescript-eslint/eslint-plugin": "^8.61.0",
		"@typescript-eslint/parser": "^8.61.0",
		"eslint": "^9",
		"eslint-config-airbnb-base": "^15.0.0",
		"eslint-config-next": "16.2.8",
		"eslint-config-prettier": "^9.1.0",
