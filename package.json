{
	"name": "react-three-fiber-playground",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"packageManager": "pnpm@10.24.0",
	"scripts": {
		"dev": "next",
		"build": "GITHUB_PAGES_BASE_PATH= NEXT_PUBLIC_SITE_BASE_PATH= next build",
